{
  "name": "littlequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "android:assets": "node sync-android.mjs",
    "android:build": "./scripts/build-android.sh",
    "check": "biome check --error-on-warnings .",
    "fix": "biome check --write . && npm run android:assets",
    "hooks:install": "git config core.hooksPath .githooks",
    "android:bundle": "./scripts/build-android.sh --bundle",
    "android:release": "./scripts/build-android.sh --release",
    "store:check": "node scripts/check-store.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
